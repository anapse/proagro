# PROAGRO-WEB-FORENSICS — configuración por variables de entorno.
# Copia este archivo como ".env" y ajusta si es necesario.
# El proyecto NO contiene secretos: claves/tokens/contraseñas van SIEMPRE
# en variables de entorno del sistema, nunca en archivos del proyecto.

# Puerto HTTP principal del dashboard (0.0.0.0:PORT) — en el VPS usa 3792
PORT=3792

# HTTPS: DESACTIVADO por defecto. Si necesitas la cámara en una tablet,
# actívalo con un puerto distinto (p. ej. 3793) y un certificado en tls/:
#   HTTPS_PORT=3793
HTTPS_PORT=0

# Interfaz de escucha. 0.0.0.0 = todas las interfaces (necesario para VPS/LAN)
HOST=0.0.0.0

# 1 = no abrir el navegador automáticamente al iniciar
NO_BROWSER=1
